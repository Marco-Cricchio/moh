{
  "steps": [
    {
      "prompt": "start the work",
      "cassette": [
        {
          "deltas": [],
          "finish": "tool_calls",
          "toolCalls": [{ "name": "write", "args": { "path": "progress.txt", "content": "step one\n" } }]
        },
        { "deltas": ["Started."], "finish": "stop" }
      ],
      "permissions": { "allow": ["write"] },
      "assertions": { "files": [{ "path": "progress.txt" }] }
    },
    {
      "prompt": "continue on the fork",
      "cassette": [
        {
          "deltas": [],
          "finish": "tool_calls",
          "toolCalls": [{ "name": "edit", "args": { "path": "progress.txt", "oldText": "one", "newText": "two" } }]
        },
        { "deltas": ["Continued on the fork."], "finish": "stop" }
      ],
      "permissions": { "allow": ["edit", "read"] },
      "fork": true,
      "assertions": { "files": [{ "path": "progress.txt", "content": "step two\n" }] }
    }
  ],
  "sessionAssertions": {
    "chromeEvents": ["session_resumed"]
  }
}
